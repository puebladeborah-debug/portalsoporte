rules_version = '2';

// Reglas de Firebase Storage — Portal de Soporte, Club Sinergético.
// Mismo criterio que Firestore: solo el equipo con sesión real de
// Firebase Authentication puede subir, leer o borrar archivos.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /entregables/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
